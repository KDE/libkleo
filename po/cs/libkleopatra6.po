#: ui/editdirectoryservicedialog.cpp:184
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Use GnuPG's default to connect to the LDAP server. By default, GnuPG 2.3 and "
"earlier use a plain, not TLS secured connection. <b>(Not recommended)</b>"
msgstr ""
"Pro připojení k serveru LDAP použít výchozí nastavení programu GnuPG. Ve "
"výchozím nastavení používají GnuPG 2.3 a starší verze nezabezpečené "
"připojení bez protokolu TLS. <b>(Nedoporučuje se)</b>"

#: ui/editdirectoryservicedialog.cpp:192
#, kde-format
msgid "Do not use a TLS secured connection"
msgstr "Nepoužívat připojení zabezpečené protokolem TLS"

#: ui/editdirectoryservicedialog.cpp:194
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Use a plain, not TLS secured connection to connect to the LDAP server. "
"<b>(Not recommended)</b>"
msgstr ""
"Pro připojení k serveru LDAP použít nezabezpečené připojení, nikoli "
"připojení zabezpečené protokolem TLS. <b>(Nedoporučuje se)</b>"

#: ui/editdirectoryservicedialog.cpp:200
#, kde-format
msgid "Use TLS secured connection"
msgstr "Použít připojení zabezpečené protokolem TLS"

#: ui/editdirectoryservicedialog.cpp:202
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Use a standard TLS secured connection (initiated with STARTTLS) to connect "
"to the LDAP server. <b>(Recommended)</b>"
msgstr ""
"K připojení k serveru LDAP použít standardní připojení zabezpečené "
"protokolem TLS (iniciované příkazem STARTTLS). <b>(Doporučeno)</b>"

#: ui/editdirectoryservicedialog.cpp:209
#, kde-format
msgid "Tunnel LDAP through a TLS connection"
msgstr "Tunelovat LDAP přes připojení TLS"

#: ui/editdirectoryservicedialog.cpp:211
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Use a TLS secured connection through which the connection to the LDAP server "
"is tunneled. <b>(Not recommended)</b>"
msgstr ""
"Použít připojení zabezpečené protokolem TLS, přes které je tunelováno "
"připojení k serveru LDAP. <b>(Nedoporučuje se)</b>"

