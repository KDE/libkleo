msgctxt "@info"
msgid "Signed by %1 on %2."
msgstr "Podepsáno %1 %2."

#: utils/formatting.cpp:1567
#, kde-format
msgctxt "@info"
msgid "Signed by %1."
msgstr "Podepsáno %1."

#: utils/formatting.cpp:1576
#, kde-format
msgctxt ""
"%1 is a placeholder for the name of a compliance mode. E.g. NATO RESTRICTED "
"compliant or VS-NfD compliant"
msgid "The signature is %1."
msgstr "Podpis je %1."

#: utils/formatting.cpp:1579
#, kde-format
msgctxt ""
"%1 is a placeholder for the name of a compliance mode. E.g. NATO RESTRICTED "
"compliant or VS-NfD compliant"
msgid "The signature <b>is not</b> %1."
msgstr "Podpis <b>není</b> %1."

#: utils/formatting.cpp:1596
#, kde-format
msgctxt "1 is a date"
msgid ""
"Signature created on %1 using an unknown certificate with fingerprint %2"
msgstr "Podpis byl vytvořen %1 pomocí neznámého certifikátu s otiskem %2"

#: utils/formatting.cpp:1598
#, kde-format
msgid "Signature created using an unknown certificate with fingerprint %1"
msgstr "Podpis byl vytvořen pomocí neznámého certifikátu s otiskem %1"

#: utils/formatting.cpp:1602
#, kde-format
msgctxt "1 is a date"
msgid "Signature created on %1 with certificate: %2"
msgstr "Podpis vytvořen %1 pomocí certifikátu: %2"

#: utils/formatting.cpp:1604
#, kde-format
msgid "Signature created with certificate: %1"
msgstr "Podpis vytvořený pomocí certifikátu: %1"

#: utils/formatting.cpp:1615
#, kde-format
msgid "Error: Signature not verified"
msgstr "Chyba: Podpis neověřen"

#: utils/formatting.cpp:1617
#, kde-format
msgid "Good signature"
msgstr "Správný podpis"

#: utils/formatting.cpp:1619
#, kde-format
msgid "Signing certificate was revoked"
msgstr "Podepisující certifikát byl odvolán"

#: utils/formatting.cpp:1621
#, kde-format
msgid "Signing certificate is expired"
msgstr "Podepisující certifikát vypršel"

#: utils/formatting.cpp:1623
#, kde-format
msgid "Certificate is not available"
msgstr "Certifikát není dostupný"

#: utils/formatting.cpp:1625
#, kde-format
msgid "Signature expired"
msgstr "Podpis vypršel"

#: utils/formatting.cpp:1627
#, kde-format
msgid "CRL missing"
msgstr "Chybí CRL"

#: utils/formatting.cpp:1629
#, kde-format
msgid "CRL too old"
msgstr "Příliš stará CRL"

#: utils/formatting.cpp:1631
#, kde-format
msgid "Bad policy"
msgstr "Špatné zásady"

#: utils/formatting.cpp:1633
#, kde-format
msgid "System error"
msgstr "Systémová chyba"

#: utils/formatting.cpp:1635
#, kde-format
msgid "Bad signature"
msgstr "Chybný podpis"

#: utils/formatting.cpp:1686 utils/formatting.cpp:1750
#: utils/formatting.cpp:1833
#, kde-format
msgid "The signature is invalid: %1"
msgstr "Podpis není platný: %1"

#: utils/formatting.cpp:1693
#, kde-format
msgid "You can search the certificate on a keyserver or import it from a file."
msgstr ""
"Certifikát můžete hledat na serveru klíčů, nebo jej importovat ze souboru."

#: utils/formatting.cpp:1699 utils/formatting.cpp:1709
#, kde-format
msgctxt "@info"
msgid ""
"The signature is valid but the used key is not certified by you or any "
"trusted person."
msgstr ""
"Podpis je platný, ale použitý klíč nebyl certifikován vámi ani žádnou "
"důvěryhodnou osobou."

#: utils/formatting.cpp:1701 utils/formatting.cpp:1740
#, kde-format
msgctxt "@info"
msgid ""
"The signature is valid but the used certificate is not certified by a "
"trustworthy Certificate Authority or the Certificate Authority is unknown."
msgstr ""
"Podpis je platný, ale použitý certifikát nebyl vydán důvěryhodnou "
"certifikační autoritou nebo je certifikační autorita neznámá."

#: utils/formatting.cpp:1704 utils/formatting.cpp:1724
#: utils/formatting.cpp:1743
#, kde-format
msgctxt "@info"
msgid ""
"<strong>Warning:</strong> There is no indication that the signature belongs "
"to the owner."
msgstr ""
"<strong>Upozornění:</strong> Neexistuje žádný důkaz, že podpis patří "
"majiteli."

#: utils/formatting.cpp:1710 utils/formatting.cpp:1720
#, kde-format
msgctxt "@info"
msgid ""
"<strong>Warning:</strong> It is not certain that the signature belongs to "
"the owner."
msgstr "<strong>Upozornění:</strong> Není jisté, zda podpis patří majiteli."

#: utils/formatting.cpp:1716
#, kde-format
msgctxt "@info"
msgid "The signature is valid but it has expired."
msgstr "Podpis je platný, ale jeho platnost již vypršela."

#: utils/formatting.cpp:1718 utils/formatting.cpp:1722
#, kde-format
msgctxt "@info"
msgid ""
"The signature is valid but it has expired and the used key is not certified "
"by you or any trusted person."
msgstr ""
"Podpis je platný, ale jeho platnost již vypršela a použitý klíč nebyl "
"certifikován ani vámi, ani žádnou důvěryhodnou osobou."

#: utils/formatting.cpp:1733
#, kde-format
msgctxt "@info"
msgid "The signature is valid but the used key has expired."
msgstr "Podpis je platný, ale platnost použitého klíče vypršela."

#: utils/formatting.cpp:1735
#, kde-format
msgctxt "@info"
msgid "The signature is valid but the used key has been revoked."
msgstr "Podpis je platný, ale použitý klíč byl odvolán."

#: utils/formatting.cpp:1736
#, kde-format
msgctxt "@info"
msgid "<strong>Warning:</strong> This could mean that the signature is forged."
msgstr ""
"<strong>Upozornění:</strong> To by mohlo znamenat, že podpis je padělaný."

#: utils/formatting.cpp:1738
#, kde-format
msgctxt "@info"
msgid "The used key is not certified by you or any trusted person."
msgstr ""
"Použitý klíč nebyl certifikován ani vámi, ani žádnou důvěryhodnou osobou."

#: utils/formatting.cpp:1768
#, kde-format
msgctxt "@info"
msgid ""
"Signature verification was successful: Data and signature match and the "
"certificate is valid and trusted."
msgstr ""
"Ověření podpisu proběhlo úspěšně: Data a podpis se shodují a certifikát je "
"platný a důvěryhodný."

#: utils/formatting.cpp:1774
#, kde-format
msgctxt "@info"
msgid "Data and signature do not match."
msgstr "Údaje a podpis se neshodují."

#: utils/formatting.cpp:1775
#, kde-format
msgctxt "@info"
msgid "The signing certificate must not be trusted."
msgstr "Podpisovému certifikátu nelze důvěřovat."

#: utils/formatting.cpp:1776 utils/formatting.cpp:1789
#: utils/formatting.cpp:1806 utils/formatting.cpp:1812
#: utils/formatting.cpp:1818 utils/formatting.cpp:1824
#, kde-format
msgctxt "@info"
msgid "The data cannot be trusted. Reason: %1"
msgstr "Těmto datům nelze důvěřovat. Důvod: %1"

#: utils/formatting.cpp:1779
#, kde-format
msgctxt "@info"
msgid "The signature claims to be from %1 and is dated %2."
msgstr "Podpis údajně pochází od %1 a je datován %2."

#: utils/formatting.cpp:1783
#, kde-format
msgctxt "@info"
msgid "The signature claims to be from %1."
msgstr "Podpis údajně pochází od %1."

#: utils/formatting.cpp:1788
#, kde-format
msgctxt "@info"
msgid ""
"The signature cannot be verified because the corresponding certificate is "
"not available."
msgstr "Podpis nelze ověřit, protože příslušný certifikát není k dispozici."

#: utils/formatting.cpp:1793
#, kde-format
msgctxt "@info"
msgid "The signing certificate’s fingerprint is %1."
msgstr "Otisk certifikátu podpisu je %1."

#: utils/formatting.cpp:1798
#, kde-format
msgctxt "@info"
msgid "The signing certificate’s serial number and issuer are %1."
msgstr "Sériové číslo certifikátu podpisu a jeho vydavatel jsou %1."

#: utils/formatting.cpp:1805
#, kde-format
msgctxt "@info"
msgid ""
"It cannot be verified whether the data originates from the stated source."
msgstr "Nelze ověřit, zda data pocházejí z uvedeného zdroje."

#: utils/formatting.cpp:1811
#, kde-format
msgctxt "@info"
msgid "The signature has expired."
msgstr "Platnost podpisu vypršela."

#: utils/formatting.cpp:1817
#, kde-format
msgctxt "@info"
msgid "The signing certificate has expired."
msgstr "Platnost podpisového certifikátu vypršela."

#: utils/formatting.cpp:1823
#, kde-format
msgctxt "@info"
msgid "The signing certificate has been revoked."
msgstr "Podpisový certifikát byl odvolán."

#: utils/formatting.cpp:1846
#, kde-format
msgctxt "@info"
msgid ""
"The signing certificate is not present in your certificate list, but it is "
"needed to verify the data."
msgstr ""
"Podpisový certifikát se ve vašem seznamu certifikátů nenachází, je však "
"potřebný k ověření údajů."

#: utils/formatting.cpp:1851
#, kde-format
msgctxt "@info"
msgid ""
"Technically, signature and data match, but the signing certificate is not "
"marked as trusted. Therefore the data cannot be trusted to originate from "
"the stated source."
msgstr ""
"Technicky vzato se podpis a data shodují, ale podpisový certifikát není "
"označen jako důvěryhodný. Nelze tedy s jistotou tvrdit, že data pocházejí z "
"uvedeného zdroje."

#: utils/formatting.cpp:1857
#, kde-format
msgctxt "@info"
msgid ""
"For an expired certificate, it cannot be evaluated whether the certificate "
"can be trusted. Therefore the data cannot be trusted. Technically, signature "
"and data match."
msgstr ""
"U certifikátu, jehož platnost vypršela, nelze posoudit, zda je certifikát "
"důvěryhodný. Z tohoto důvodu nelze důvěřovat ani údajům. Z technického "
"hlediska se podpis a údaje shodují."

#: utils/formatting.cpp:1859
#, kde-format
msgctxt "@info"
msgid ""
"If the certificate was valid and trusted when you received the data, the "
"data is likely valid."
msgstr ""
"Pokud byl certifikát v okamžiku přijetí dat platný a důvěryhodný, jsou data "
"s největší pravděpodobností platná."

#: utils/formatting.cpp:1862
#, kde-format
msgctxt "@info"
msgid ""
"The certificate may have been revoked because it was compromised and it "
"might now be used by a third party. The data can therefore not be trusted. "
"Technically, signature and data match."
msgstr ""
"Certifikát mohl být zrušen, protože došlo k jeho zneužití a nyní jej možná "
"používá třetí strana. Těmto údajům proto nelze důvěřovat. Z technického "
"hlediska se podpis a údaje shodují."

#: utils/formatting.cpp:1865
#, kde-format
msgctxt "@info"
msgid ""
"It is possible that you received the data at a time when the certificate was "
"still valid and trusted. If this is the case, the data may be valid."
msgstr ""
"Je možné, že jste data obdrželi v době, kdy byl certifikát ještě platný a "
"důvěryhodný. Pokud tomu tak je, mohou být data platná."

#: utils/formatting.cpp:1871
#, kde-format
msgctxt "@info"
msgid ""
"The data or the signature has been altered. This can happen accidentally (e."
"g. due to a transmission error), unintentionally (e.g. due to a subsequent "
"change to the data, possibly by an email client), or intentionally "
"(deliberate manipulation)."
msgstr ""
"Data nebo podpis byly pozměněny. K tomu může dojít náhodně (např. v důsledku "
"chyby při přenosu), neúmyslně (např. v důsledku následné změny dat, případně "
"ze strany e-mailového klienta) nebo úmyslně (záměrná manipulace)."

#: utils/formatting.cpp:1888
#, kde-format
msgctxt "@info"
msgid ""
"Ask the sender for the certificate or import it from a file or a keyserver. "
"Then verify the data again."
msgstr ""
"Požádejte odesílatele o certifikát nebo jej načtěte ze souboru či ze serveru "
"klíčů. Poté údaje znovu ověřte."

#: utils/formatting.cpp:1893
#, kde-format
msgctxt "@info"
msgid ""
"Verify the certificate’s fingerprint and certify it. Then verify the data "
"again."
msgstr "Ověřte otisk certifikátu a potvrďte jej. Poté data znovu ověřte."

#: utils/formatting.cpp:1894
#, kde-format
msgctxt "@info"
msgid ""
"Verify the certificate’s Root-CA fingerprint and trust it. Then verify the "
"data again."
msgstr ""
"Ověřte otisk kořenové certifikační autority (Root-CA) certifikátu a označte "
"jej jako důvěryhodný. Poté data znovu ověřte."

#: utils/formatting.cpp:1900
#, kde-format
msgctxt "@info"
msgid ""
"You can look for an updated certificate on a keyserver, or ask the sender "
"for it, then verify the data again after importing the certificate."
msgstr ""
"Můžete vyhledat aktualizovaný certifikát na serveru klíčů nebo o něj požádat "
"odesílatele a poté po importu certifikátu údaje znovu ověřit."

#: utils/formatting.cpp:1903
#, kde-format
msgctxt "@info"
msgid ""
"If in doubt, contact the signer to clarify the situation and, if necessary, "
"ask them to resend the data with a current certificate."
msgstr ""
"V případě pochybností se obraťte na podepisujícího, abyste si situaci "
"vyjasnili, a v případě potřeby ho požádejte, aby data zaslal znovu s platným "
"certifikátem."

#: utils/formatting.cpp:1907
#, kde-format
msgctxt "@info"
msgid ""
"If in doubt, contact the signer to clarify the situation and, if necessary, "
"ask them to resend the data signed with a current certificate."
msgstr ""
"V případě pochybností se obraťte na podepisujícího, abyste si situaci "
"vyjasnili, a v případě potřeby ho požádejte, aby vám data podepsaná "
"aktuálním certifikátem zaslal znovu."

#: utils/formatting.cpp:1911
#, kde-format
msgctxt "@info"
msgid "Ask the sender to resend the data."
msgstr "Požádat odesílatele, aby data poslal znovu."

#: utils/gnupg.cpp:437
#, kde-format
msgctxt "@info"
msgid "GnuPG provides support for OpenPGP/LibrePGP and S/MIME."
msgstr "GnuPG podporuje OpenPGP/LibrePGP a S/MIME."

#: utils/gnupg.cpp:446
#, kde-format
msgctxt "@info"
msgid "Libgcrypt is a general purpose cryptographic library."
msgstr "Libgcrypt je univerzální kryptografická knihovna."

